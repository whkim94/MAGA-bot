DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional. Set for fast guild-only slash command sync while developing.
DISCORD_GUILD_ID=

# Optional. If empty, the bot uses public https://t.me/s scraping.
# Set these later to switch to the more stable Telethon API mode.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Recommended for Railway. Create it with: python scripts/create_telegram_session.py
TELEGRAM_SESSION=

# Railway Volume mount path is usually injected automatically.
# Set this explicitly if you mount the volume at /app/data.
BOT_DATA_DIR=/app/data

POLL_INTERVAL_SECONDS=60
FETCH_LIMIT_PER_CHANNEL=30
BOT_LOG_LEVEL=INFO

# Optional X/Twitter feed bridge. Public X is anti-bot heavy, so this uses RSS bridge URLs.
X_BEARER_TOKEN=
# auto: API first if X_BEARER_TOKEN exists, then RSS fallback. api: API only. rss: RSS only.
X_POLL_MODE=auto
NITTER_BASE_URL=https://nitter.net,https://xcancel.com,https://rss.xcancel.com
# Override if you use RSSHub/Nitter/etc. Example: {base}/{username}/rss
X_FEED_URL_TEMPLATE=
